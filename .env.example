# ============================================================
# ENVIRONMENT VARIABLES — Company Management API
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!
# ============================================================

# ---- Database (production) ----
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/testdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=00001111

# ---- JWT ----
JWT_SECRET_KEY=your-secret-key-at-least-256-bits-long-for-hs256-algorithm
JWT_EXPIRATION_TIME=86400000

# ---- Sentry ----
SENTRY_DSN=
ENV=development

# ---- Bcrypt ----
SECURITY_BCRYPT_STRENGTH=10

# ============================================================
# TEST ENVIRONMENT VARIABLES (optional overrides)
# ============================================================

# ---- Testcontainers PostgreSQL ----
TC_POSTGRES_IMAGE=postgres:15.2
TC_DB_NAME=test-db
TC_DB_USERNAME=test
TC_DB_PASSWORD=test

# ---- Testcontainers Docker ----
DOCKER_HOST=unix:///var/run/docker.sock
TESTCONTAINERS_REUSE_ENABLE=true

# ============================================================
# CI / SONARQUBE (set in GitHub Secrets)
# ============================================================
# SONAR_TOKEN=
# SONAR_HOST_URL=https://sonarcloud.io
# SONAR_PROJECT_KEY=ompany-management
# SONAR_ORGANIZATION=my-org